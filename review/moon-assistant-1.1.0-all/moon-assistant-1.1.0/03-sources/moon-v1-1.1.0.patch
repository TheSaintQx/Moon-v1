+  calls.push({
+    url: url.href,
+    method: String(options.method || 'GET').toUpperCase(),
+    headers: options.headers || {},
+    body: String(options.body || '')
+  });
+
+  return new Response(JSON.stringify(reply.body), {
+    status: reply.status,
+    headers: { 'content-type': 'application/json' }
+  });
